# CEKAS (Catatan Keuangan Kelas XI-F2) - Pure Python Edition
# Salin file ini menjadi .env lalu isi. JANGAN commit .env.
GCP_PROJECT_ID=
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
CLASS_ID=XI-F2
CLASS_NAME=Kelas XI-F2 SMA Kartika XIX-1 Bandung
CEKAS_DB_PATH=cekas.db

# PIN Bendahara (min. 6 karakter, dipakai /klaimbendahara). WAJIB diganti.
# Kosongkan = dibuat acak saat kelas pertama dibuat (tampil sekali di log).
# Untuk database yang sudah ada: python run.py set-pin <PIN_BARU>
PIN_BENDAHARA=

# Verifikasi Wali Kelas (default AKTIF): semua pemasukan, pengeluaran, iuran, dan koreksi
# menunggu persetujuan guru. Guru masuk lewat /klaimwali <PIN_WALI> di bot. 0 = nonaktif.
TEACHER_VERIFICATION=1
PIN_WALI=

# Login web admin (kosong = dashboard hanya-baca, aksi tulis web nonaktif)
WEB_ADMIN_PASSWORD=
WEB_ADMIN_NAME=Bendahara (Web)
# Kunci penanda-tangan cookie sesi; isi string acak panjang agar login bertahan setelah restart
# (buat dengan: python -c "import secrets; print(secrets.token_hex(32))")
CEKAS_SECRET_KEY=

# Tanggal Senin minggu ke-1 semester (YYYY-MM-DD). Kosong = minggu aktif = minggu terakhir yang ada pembayaran.
SEMESTER_START=
# Pengeluaran >= ambang butuh persetujuan N siswa terdaftar (0 = nonaktif)
APPROVAL_THRESHOLD=50000
APPROVALS_NEEDED=3
# URL publik (untuk QR & tautan rekap). Kosong = pakai alamat yang sedang diakses.
PUBLIC_URL=
# Replikasi database ke Cloud Storage agar data tetap ada di cloud (diisi otomatis oleh deploy_gcp.py)
CEKAS_GCS_BUCKET=
# Pembaca foto nota lokal (opsional), mis. Gemma via Ollama
OLLAMA_URL=
OLLAMA_MODEL=gemma3:4b

# Wajib untuk mode webhook. Daftarkan ke Telegram dengan parameter secret_token yang sama:
#   setWebhook?url=<URL>/api/telegram/webhook&secret_token=<NILAI_INI>
TELEGRAM_WEBHOOK_SECRET=
