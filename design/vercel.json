{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://cekas-pgku264xda-uc.a.run.app/api/:path*" },
    { "source": "/langit", "destination": "https://cekas-pgku264xda-uc.a.run.app/langit" },
    { "source": "/langit/:path*", "destination": "https://cekas-pgku264xda-uc.a.run.app/langit/:path*" }
  ]
}
